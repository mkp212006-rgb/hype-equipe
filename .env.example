NODE_ENV=development
PORT=3000

# PostgreSQL. No Railway, use a variável DATABASE_URL do serviço PostgreSQL.
DATABASE_URL=postgresql://hype:hype_dev@localhost:5432/hype_equipe
DATABASE_SSL=false

# Gere com: npm run secret
JWT_SECRET=substitua-por-um-segredo-com-pelo-menos-32-caracteres

# Administrador inicial. O usuário é criado somente se ainda não existir no banco.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=defina-esta-senha-como-variavel-privada

# Integração SMMHype. Nunca coloque a chave real no GitHub.
SMM_API_URL=https://smmhype.com/api/v2
SMM_API_KEY=cole-a-chave-da-api-na-variavel-privada-do-railway
SMM_TIMEOUT_MS=20000

# Opcional: cria o primeiro código da equipe. Se ficar vazio, defina pelo painel admin.
INITIAL_TEAM_CODE=

# Opcional: origens web adicionais separadas por vírgula.
ALLOWED_ORIGINS=

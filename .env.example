NODE_ENV=production
PORT=3000

# PostgreSQL do Railway
DATABASE_URL=postgresql://usuario:senha@host:porta/banco
DATABASE_SSL=false

# Gere um segredo forte com 32+ caracteres
JWT_SECRET=troque-por-um-segredo-forte-com-mais-de-32-caracteres
TOKEN_TTL_SECONDS=43200

# Administrador inicial
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-por-uma-senha-forte-com-12-ou-mais-caracteres

# SMMHype
SMM_API_URL=https://smmhype.com/api/v2
SMM_API_KEY=cole-a-chave-da-smmhype
SMM_TIMEOUT_MS=20000

# Mercado Pago - credenciais ficam SOMENTE no Railway
MP_ACCESS_TOKEN=APP_USR-cole-seu-access-token-aqui
MP_WEBHOOK_SECRET=cole-a-assinatura-secreta-do-webhook-aqui
MP_TIMEOUT_MS=20000

# URL pública do backend
PUBLIC_BASE_URL=https://tw-store-application.up.railway.app

# Opcional
ALLOWED_ORIGINS=
